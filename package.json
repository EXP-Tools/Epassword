{
  "name": "epassword",
  "version": "1.2.0",
  "description": "Local Excel-backed password manager",
  "main": "electron/main.cjs",
  "author": "Epassword",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "node scripts/pack.cjs",
    "dist": "node scripts/pack.cjs --dist",
    "test:desktop": "node tests/desktop.cjs",
    "dist:win": "node scripts/pack.cjs --dist --platform=win --arch=x64",
    "dist:mac": "node scripts/pack.cjs --dist --platform=mac",
    "dist:mac:arm64": "node scripts/pack.cjs --dist --platform=mac --arch=arm64",
    "dist:mac:x64": "node scripts/pack.cjs --dist --platform=mac --arch=x64",
    "dist:mac:signed": "node scripts/pack.cjs --dist --platform=mac --signed",
    "test:platform": "node tests/platform-smoke.cjs",
    "pack:extension": "node scripts/pack-extension.cjs",
    "test:browser": "node tests/browser-desktop.cjs",
    "pack:setup": "node scripts/pack-setup.cjs",
    "test:installer": "node tests/installer-smoke.cjs",
    "install:local": "node scripts/install.cjs",
    "test:api": "node tests/api-desktop.cjs",
    "test:transfer": "node tests/transfer-desktop.cjs",
    "test:search": "node tests/search-desktop.cjs",
    "test:share": "node tests/share-desktop.cjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jsqr": "^1.4.0",
    "officecrypto-tool": "0.0.19",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "41.10.7",
    "electron-builder": "^26.0.12",
    "qrcode": "^1.5.4",
    "archiver": "5.3.2"
  },
  "build": {
    "appId": "local.epassword.desktop",
    "productName": "Epassword",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
