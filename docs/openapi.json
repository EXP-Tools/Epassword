    "/v1/logins/search": {
      "post": {
        "operationId": "searchLogins",
        "summary": "List exact-origin active logins without passwords; requires logins:list",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
