{
  "openapi": "3.1.1",
  "info": {
    "title": "Epassword Local Program API",
    "version": "1.0.0",
    "description": "Local native clients only. Create a scoped, expiring token in the desktop app. Tokens are revoked on vault lock, master-password change or app exit. No unlock, write, OTP or bulk export endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:29744"
    }
  ],
  "security": [
    {
      "localToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "localToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "epw.<client UUID>.<random secret>"
      }
    },
    "schemas": {
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "logins:list",
                "credentials:read"
              ]
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "origins",
          "scopes",
          "expiresAt",
          "lastUsedAt"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/status": {
      "post": {
        "operationId": "getStatus",
        "summary": "Read this token's authorization and vault status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success (Cache-Control: no-store)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "string",
                      "const": "1"
                    },
                    "unlocked": {
                      "type": "boolean",
                      "const": true
                    },
                    "client": {
                      "$ref": "#/components/schemas/Client"
                    }
                  },
                  "required": [
                    "apiVersion",
                    "unlocked",
                    "client"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "apiVersion": "1",
                  "unlocked": true,
                  "client": {
                    "id": "11111111-1111-4111-8111-111111111111",
                    "name": "Local automation",
                    "origins": [
                      "https://example.com"
                    ],
                    "scopes": [
                      "logins:list",
                      "credentials:read"
                    ],
                    "expiresAt": "2026-09-26T10:00:00.000Z",
                    "lastUsedAt": "2026-09-26T09:01:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or request fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid_json": {
                    "value": {
                      "error": {
                        "code": "invalid_json",
                        "message": "Invalid JSON body."
                      }
                    }
                  },
                  "invalid_request": {
                    "value": {
                      "error": {
                        "code": "invalid_request",
                        "message": "Unexpected request field."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid, expired, revoked or vault authorization changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Token invalid, expired or revoked; authorize in Epassword again."
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden browser source, Host, origin or scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "source_forbidden": {
                    "value": {
                      "error": {
                        "code": "source_forbidden",
                        "message": "Use a local native HTTP client; browser origins are not accepted."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown endpoint or no active matching login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "not_found": {
                    "value": {
                      "error": {
                        "code": "not_found",
                        "message": "Unknown API endpoint."
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Only POST supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "method_not_allowed": {
                    "value": {
                      "error": {
                        "code": "method_not_allowed",
                        "message": "Use POST with a JSON body."
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 8 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "body_too_large": {
                    "value": {
                      "error": {
                        "code": "body_too_large",
                        "message": "Request body exceeds 8 KB."
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "unsupported_media_type": {
                    "value": {
                      "error": {
                        "code": "unsupported_media_type",
                        "message": "Use application/json."
                      }
                    }
                  }
                }
              }
            }
          },
          "423": {
            "description": "Vault is locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "locked": {
                    "value": {
                      "error": {
                        "code": "locked",
                        "message": "Unlock the vault in Epassword."
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "60 requests/minute/client exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "error": {
                        "code": "rate_limited",
