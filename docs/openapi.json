                "schema": {
                  "type": "object",
                  "properties": {
                    "origin": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "username": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "username"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "origin",
                    "items"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "origin": "https://example.com",
                  "items": [
                    {
                      "id": "22222222-2222-4222-8222-222222222222",
                      "title": "Example account",
                      "username": "demo@example.com"
