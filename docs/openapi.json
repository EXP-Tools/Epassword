    "/v1/logins/credentials": {
      "post": {
        "operationId": "readLoginCredential",
        "summary": "Read one exact-origin login; requires credentials:read. Response contains a plaintext password: never return it to an LLM, trace or log.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "itemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "url",
                  "itemId"
                ],
                "additionalProperties": false
              },
              "example": {
                "url": "https://example.com/login",
                "itemId": "22222222-2222-4222-8222-222222222222"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success (Cache-Control: no-store)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
